rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidResume(data) {
      return data.userId == request.auth.uid
        && data.id is string
        && isValidId(data.id)
        && (!('title' in data) || (data.title is string && data.title.size() <= 200));
    }

    function isValidAtsAnalysis(data) {
      return data.userId == request.auth.uid
        && data.id is string
        && isValidId(data.id)
        && data.resumeName is string && data.resumeName.size() <= 200
        && data.jobTitle is string && data.jobTitle.size() <= 200
        && data.originalScore is number
        && data.latestScore is number;
    }

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Read-only connection probe document
    match /test/{testId} {
      allow get: if true;
    }

    // User profile document strictly isolated per authenticated UID
    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId);

      // Resumes subcollection strictly isolated per user
      match /resumes/{resumeId} {
        allow get: if isOwner(userId) && isValidId(resumeId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(resumeId)
          && isValidResume(request.resource.data);
        allow update: if isOwner(userId)
          && isValidId(resumeId)
          && isValidResume(request.resource.data)
          && request.resource.data.userId == resource.data.userId
          && (!('id' in resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId) && isValidId(resumeId);
      }

      // ATS Resume Analyses subcollection strictly isolated per user
      match /atsAnalyses/{analysisId} {
        allow get: if isOwner(userId) && isValidId(analysisId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(analysisId)
          && isValidAtsAnalysis(request.resource.data);
        allow update: if isOwner(userId)
          && isValidId(analysisId)
          && isValidAtsAnalysis(request.resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId) && isValidId(analysisId);
      }
    }
  }
}
