{
  "entities": {
    "Resume": {
      "title": "Resume",
      "description": "A structured resume document containing personal info, objective, education, experience, skills, projects, certifications, and achievements.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier of the resume document."
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the owner."
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Title or label for this resume."
        },
        "personalInfo": {
          "type": "object",
          "description": "Personal contact details, name, headline, optional cropped photo, and metadata."
        },
        "personalQuote": {
          "type": "string",
          "maxLength": 600,
          "description": "Optional personal motto or statement."
        },
        "objective": {
          "type": "string",
          "maxLength": 2000,
          "description": "Career objective or executive summary."
        },
        "education": {
          "type": "array",
          "description": "List of education history entries."
        },
        "thesis": {
          "type": "object",
          "description": "Optional Master's thesis or research project details."
        },
        "studyAbroad": {
          "type": "array",
          "description": "Optional study-abroad academic entries."
        },
        "highSchool": {
          "type": "array",
          "description": "Optional high-school academic entries."
        },
        "skills": {
          "type": "array",
          "description": "List of technical/computer skills and competencies."
        },
        "labSkills": {
          "type": "array",
          "description": "Optional laboratory and research skills."
        },
        "harvardLeadershipFirst": {
          "type": "boolean",
          "description": "Optional preference to display Leadership & Activities above Experience in Harvard Style."
        },
        "targetBackground": {
          "type": "string",
          "maxLength": 32,
          "description": "Adaptive profile focus: student, fresher, or experienced."
        },
        "skillMatrix": {
          "type": "array",
          "description": "Optional structured skill proficiency matrix (levels 1-5)."
        },
        "projects": {
          "type": "array",
          "description": "List of key projects."
        },
        "dailyActivities": {
          "type": "array",
          "description": "Optional daily time breakdown items (total <= 24 hours)."
        },
        "showDailyActivityChart": {
          "type": "boolean",
          "description": "Whether the optional A Day of My Life donut chart is shown."
        },
        "strengths": {
          "type": "array",
          "description": "Optional custom strength tags."
        },
        "experience": {
          "type": "array",
          "description": "List of professional and vocational work experiences."
        },
        "languages": {
          "type": "array",
          "description": "Optional spoken languages and proficiency levels."
        },
        "interests": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional inline interests string."
        },
        "interestItems": {
          "type": "array",
          "description": "Optional structured interests with descriptions."
        },
        "customSections": {
          "type": "array",
          "description": "Optional custom additional information sections."
        },
        "references": {
          "type": "array",
          "description": "Optional professional or academic references."
        },
        "referencesDisplayMode": {
          "type": "string",
          "maxLength": 32,
          "description": "Display mode for references: detailed, on-request, or hidden."
        },
        "certifications": {
          "type": "array",
          "description": "List of certifications and licenses."
        },
        "achievements": {
          "type": "array",
          "description": "List of honors and achievements."
        },
        "template": {
          "type": "string",
          "maxLength": 32,
          "description": "Visual layout template identifier."
        },
        "themeColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Accent color choice."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp."
        }
      },
      "required": ["userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "User created resumes isolated by owner user account."
    }
  }
}
