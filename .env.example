# Firebase Client Configuration (Required for Vercel / Vite Frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: specify named Firestore database ID if not using (default)
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Server-Side Gemini API Key (Required for Vercel Serverless Functions / Express Backend)
GEMINI_API_KEY=
